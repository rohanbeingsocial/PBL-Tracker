# Copy this file to .env and fill in real values. Never commit .env.

# Owner connection. Used only by the scripts in scripts/ to create tables and load data.
# Supabase: Connect > Session pooler, user "postgres.<project-ref>".
ADMIN_DATABASE_URL=postgresql://postgres.your-project-ref:change-me@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Password that scripts/setup_db.py gives to the pbl_app login role.
PBL_APP_PASSWORD=change-me-too

# Connection the web app uses. Same host, but the low-privilege pbl_app role.
# Supabase: user "pbl_app.<project-ref>", password = PBL_APP_PASSWORD.
DATABASE_URL=postgresql://pbl_app.your-project-ref:change-me-too@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Password that scripts/load_data.py gives every sample user (12+ characters).
# Sample data only. Students sign in with their PRN, faculty with their email.
SEED_PASSWORD=change-me-three

# on: the sign-in page and sidebar offer one-click sign-in as five sample accounts,
# using SEED_PASSWORD. Only for a demo on your own laptop: with it on, anyone who can
# open the app can become the admin.
DEMO_SWITCHER=off

# Reports and presentations. With these set, files go to a private Supabase Storage
# bucket (Storage > New bucket, name it project-files, leave "Public" off). The secret
# key is under Project Settings > API Keys and must never reach the browser or the repo.
# Leave them empty to keep files in the uploads/ folder on this laptop.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=project-files

# Only for the local Docker database (docker compose up -d). Then use these URLs instead
# (127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and stalls for seconds):
#   ADMIN_DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5434/postgres
#   DATABASE_URL=postgresql://pbl_app:<PBL_APP_PASSWORD>@127.0.0.1:5434/postgres
POSTGRES_PASSWORD=
